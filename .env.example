# NeuroSync Care - variables de entorno (copia este archivo a .env y completa).
# NUNCA subas el archivo .env al repositorio. Los secretos viven solo en el backend.

# --- EMOTIV Cortex API (https://emotiv.gitbook.io/cortex-api/) ---
# Credenciales de tu aplicacion, creadas en https://www.emotiv.com/my-account/cortex-apps/
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=

# Opcional: id exacto del casco (ej. el que muestra EMOTIV Launcher). Vacio = primero disponible.
EMOTIV_HEADSET_ID=

# Opcional: URL de Cortex (por defecto wss://localhost:6868)
# EMOTIV_URL=wss://localhost:6868

# --- Backend ---
# NEUROSYNC_DATABASE_URL=sqlite:///./data/neurosync.db
# NEUROSYNC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# NEUROSYNC_SIMULATOR_SEED=42

