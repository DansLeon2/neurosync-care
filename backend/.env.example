# Único ejemplo de configuración: copia a backend/.env y completa las credenciales.
# Los secretos solo se leen en el backend. No publiques el archivo .env.
# Credenciales de la Cortex App: https://account.emotiv.com/my-account/cortex-apps/
EMOTIV_CLIENT_ID=
EMOTIV_CLIENT_SECRET=

# Opcional: ID exacto mostrado por Launcher; vacío = primer casco del tipo elegido.
EMOTIV_HEADSET_ID=

# Opcionales; los valores siguientes son los predeterminados.
# EMOTIV_URL=wss://localhost:6868
# NEUROSYNC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# NEUROSYNC_SIMULATOR_SEED=42
# SQLite usa backend/data/neurosync.db; sobrescribe solo si necesitas otra base.
# NEUROSYNC_DATABASE_URL=sqlite:///./data/neurosync.db

